# Copy this file to .env and fill in your own credentials.
# Never commit a real .env file — it's already in .gitignore.
# Every value below is a PLACEHOLDER. There are no real keys in this repo.
# Any platform left blank falls back to clearly-labeled demo data.

PORT=3000

# --- Admin page (/admin) — required to unlock it, no default is shipped ---
# Pick a strong, unique password. This gates the page where you paste your
# own platform credentials, so treat it like any other account password.
ADMIN_PASSWORD=
# Long random string used to sign admin session cookies. If left blank, a
# random one is generated at boot — fine for local use, but it means every
# restart invalidates existing sessions. Set one to keep sessions stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Durable storage (optional but recommended for hosted deploys) ---
# Postgres connection string. Free options: Neon (neon.tech) or any hosted
# Postgres. When set, follower history, goal, queue, logged posts, and
# competitors live in the database and survive Render free-tier spin-downs.
# When unset, everything falls back to local JSON files under data/ —
# perfect for local dev, but wiped on each free-tier wake.
# Credentials NEVER go in the database either way — they stay in env/local file.
DATABASE_URL=

# --- Notifications (optional) ---
# A Discord or Slack incoming-webhook URL. When set, Signal pushes a weekly
# growth digest and one-time milestone alerts (10K/25K/50K/100K/250K/500K/1M
# followers per platform) to that channel. Webhook URLs are secrets — anyone
# holding one can post to your channel — so this stays in env only.
#   Discord: Server Settings > Integrations > Webhooks
#   Slack:   api.slack.com/apps > Incoming Webhooks
NOTIFY_WEBHOOK_URL=

# The platform credentials below are normally entered through the admin page
# (Log in at /admin, paste each key, Save — no restart needed). Setting them
# here in .env also works and is useful for first boot or non-interactive
# deploys; the admin page's saved values take precedence over these if both
# are set.

# --- X (Twitter) — developer.x.com, API v2, Bearer token from a Project/App ---
TWITTER_BEARER_TOKEN=
TWITTER_USERNAME=

# --- YouTube — console.cloud.google.com, enable "YouTube Data API v3", create an API key ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Instagram — developers.facebook.com, Instagram Graph API, requires a
#     Business/Creator account linked to a Facebook Page, long-lived token ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Facebook Page — developers.facebook.com, Graph API, Page access token ---
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- TikTok — developers.tiktok.com, Login Kit + Display API, OAuth2 user token ---
TIKTOK_ACCESS_TOKEN=

# --- LinkedIn — developer.linkedin.com, Community Management API (requires
#     Partner Program approval), OAuth2 token scoped to your organization ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
